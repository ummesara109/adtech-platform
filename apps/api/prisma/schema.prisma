generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  Pending
  UnderReview
  Verified
  Rejected
}

enum MembershipRole {
  Admin
  CampaignManager
  BillingViewer
  Analyst
}

enum CampaignStatus {
  Draft
  Submitted
  UnderReview
  RevisionRequired
  Approved
  Scheduled
  Live
  Paused
  Completed
  Rejected
  Cancelled
}

enum ApprovalStatus {
  Draft
  Submitted
  UnderReview
  Approved
  Rejected
  RevisionRequired
}

enum DeliveryStatus {
  NotStarted
  Scheduled
  Live
  Paused
  Completed
  Cancelled
}

enum PaymentStatus {
  Pending
  Authorized
  Paid
  Failed
  Refunded
  PartiallyRefunded
}

enum CreativeType {
  Video
  Image
}

enum CreativeModerationStatus {
  Draft
  PendingModeration
  Approved
  RevisionRequired
  Archived
}

enum ActivityKind {
  campaign
  creative
  approval
  payment
  account
}

model Company {
  id                   String             @id @default(cuid())
  legalName            String             @default("")
  tradeName            String             @default("")
  businessType         String             @default("")
  gstin                String             @default("")
  registeredAddress    String             @default("")
  city                 String             @default("Bengaluru")
  industry             String             @default("")
  verificationStatus   VerificationStatus @default(Pending)
  verificationNotes    String             @default("")
  verificationSubmittedOn DateTime?
  verificationReviewedOn  DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  members       CompanyMember[]
  documents     KycDocument[]
  campaigns     Campaign[]
  creatives     Creative[]
  invoices      Invoice[]
  payments      Payment[]
  notifications Notification[]
  activities    ActivityEvent[]
  playbackDaily     PlaybackDaily[]
  playbackReports   PlaybackReport[]
  locationPlayback  LocationPlayback[]
}

enum PlatformRole {
  Advertiser
  Driver
  SuperAdmin
}

enum DriverAccountStatus {
  PendingRegistration
  Active
  Suspended
}

enum VehicleStatus {
  Pending
  Active
  Inactive
}

enum DeviceOnlineStatus {
  Offline
  Online
}

enum DevicePairingStatus {
  Unpaired
  Pending
  Paired
}

enum PlaybackEventType {
  Started
  Completed
  Interrupted
}

enum PayoutStatus {
  Pending
  Processing
  Paid
  Failed
}

model User {
  id        String   @id @default(cuid())
  /// Supabase Auth user id when connected
  authUserId String? @unique
  email     String   @unique
  fullName  String
  phone     String   @default("")
  /// Local password hash (bcrypt). Null when auth is fully delegated to Supabase.
  passwordHash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships CompanyMember[]
  roles       UserRole[]
  driver      Driver?
}

model UserRole {
  id        String       @id @default(cuid())
  userId    String
  role      PlatformRole
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model Driver {
  id              String              @id @default(cuid())
  userId          String              @unique
  accountStatus   DriverAccountStatus @default(PendingRegistration)
  kycStatus       VerificationStatus  @default(Pending)
  dateOfBirth     DateTime?
  address         String              @default("")
  city            String              @default("Bengaluru")
  licenseNumber   String              @default("")
  licenseExpiry   DateTime?
  emergencyContact String             @default("")
  kycSubmittedOn  DateTime?
  kycReviewedOn   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycDocuments      DriverKycDocument[]
  vehicles          Vehicle[]
  deviceAssignments DeviceAssignment[]
  playbackLogs      AdPlaybackLog[]
  earnings          PartnerEarning[]
  incentives        PartnerIncentive[]
  payouts           Payout[]
  supportIssues     DriverSupportIssue[]

  @@index([kycStatus])
}

model DriverSupportIssue {
  id          String   @id @default(cuid())
  driverId    String
  subject     String
  description String
  status      String   @default("Open")
  createdAt   DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model DriverKycDocument {
  id         String   @id @default(cuid())
  driverId   String
  label      String
  status     String   @default("Required")
  storageKey String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Vehicle {
  id                 String        @id @default(cuid())
  driverId           String
  registrationNumber String        @unique
  makeModel          String        @default("")
  vehicleType        String        @default("Auto Rickshaw")
  rcStorageKey       String        @default("")
  year               Int?
  color              String        @default("")
  status             VehicleStatus @default(Pending)
  adScreenId         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  driver      Driver             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  assignments DeviceAssignment[]
  playbackLogs AdPlaybackLog[]

  @@index([driverId])
}

model Device {
  id              String             @id @default(cuid())
  serialNumber    String             @unique
  firmwareVersion String             @default("")
  mqttClientId    String             @default("")
  onlineStatus    DeviceOnlineStatus @default(Offline)
  lastSeenAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignments DeviceAssignment[]
  telemetry   DeviceTelemetry[]
  playbackLogs AdPlaybackLog[]

  @@index([onlineStatus])
}

model DeviceAssignment {
  id            String              @id @default(cuid())
  deviceId      String
  vehicleId     String
  driverId      String
  pairingCode   String              @default("")
  pairingStatus DevicePairingStatus   @default(Unpaired)
  assignedAt    DateTime            @default(now())
  unassignedAt  DateTime?

  device  Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([deviceId])
  @@index([vehicleId])
}

model DeviceTelemetry {
  id             String   @id @default(cuid())
  deviceId       String
  recordedAt     DateTime @default(now())
  connectivity   String   @default("unknown")
  signalStrength Int?
  metadata       Json?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, recordedAt])
}

model AdPlaybackLog {
  id               String            @id @default(cuid())
  driverId         String
  deviceId         String?
  vehicleId        String?
  campaignId       String?
  eventType        PlaybackEventType
  idempotencyKey   String            @unique
  startedAt        DateTime?
  endedAt          DateTime?
  validDurationSec Int               @default(0)
  createdAt        DateTime          @default(now())

  driver  Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  device  Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([driverId, createdAt])
  @@index([deviceId])
}

model PartnerEarning {
  id             String @id @default(cuid())
  driverId       String
  periodYear     Int
  periodMonth    Int
  grossAmountInr Int    @default(0)
  commissionInr  Int    @default(0)
  netAmountInr   Int    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, periodYear, periodMonth])
  @@index([driverId])
}

model PartnerIncentive {
  id        String   @id @default(cuid())
  driverId  String
  title     String
  amountInr Int      @default(0)
  status    String   @default("Pending")
  earnedAt  DateTime?
  createdAt DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model Payout {
  id        String       @id @default(cuid())
  driverId  String
  amountInr Int
  status    PayoutStatus @default(Pending)
  reference String       @default("")
  paidOn    DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
}

model CompanyMember {
  id        String         @id @default(cuid())
  companyId String
  userId    String
  role      MembershipRole @default(Admin)
  createdAt DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([userId])
}

model KycDocument {
  id        String   @id @default(cuid())
  companyId String
  label     String
  status    String   @default("Required")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model InventoryArea {
  id               String @id @default(cuid())
  city             String @default("Bengaluru")
  area             String
  availableDevices Int    @default(0)
  centerLat        Float?
  centerLng        Float?

  @@unique([city, area])
}

enum ScreenStatus {
  Active
  Inactive
  Maintenance
}

enum ScreenBookingStatus {
  Hold
  Reserved
  Confirmed
  Cancelled
  Expired
}

/// Physical auto-rickshaw advertising screen with stored coordinates.
model AdScreen {
  id        String       @id @default(cuid())
  publicId  String       @unique
  autoId    String       @unique
  city      String       @default("Bengaluru")
  locality  String
  latitude  Float
  longitude Float
  status    ScreenStatus @default(Active)
  label     String       @default("")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  bookings ScreenBooking[]

  @@index([city, locality])
  @@index([status])
}

/// Inventory booking / hold for a screen over a time window (UTC).
model ScreenBooking {
  id            String              @id @default(cuid())
  screenId      String
  companyId     String?
  campaignId    String?
  startAt       DateTime
  endAt         DateTime
  status        ScreenBookingStatus
  holdExpiresAt DateTime?
  timezone      String              @default("Asia/Kolkata")
  daysOfWeek    String[]            @default([])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  screen AdScreen @relation(fields: [screenId], references: [id], onDelete: Cascade)

  @@index([screenId, startAt, endAt])
  @@index([status])
  @@index([companyId])
  @@index([campaignId])
}

model Creative {
  id               String                   @id @default(cuid())
  companyId        String
  fileName         String
  type             CreativeType
  sizeLabel        String                   @default("")
  spec             String                   @default("1920×1080 · 16:9")
  version          String                   @default("v1")
  moderationStatus CreativeModerationStatus @default(Draft)
  previewNote      String                   @default("")
  storageKey       String                   @default("")
  previewUrl       String                   @default("")
  archived         Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([companyId])
}

model Campaign {
  id               String         @id @default(cuid())
  publicId         String         @unique
  companyId        String
  name             String
  description      String         @default("")
  status           CampaignStatus @default(Draft)
  approvalStatus   ApprovalStatus @default(Draft)
  deliveryStatus   DeliveryStatus @default(NotStarted)
  paymentStatus    PaymentStatus  @default(Pending)
  startDate        DateTime?
  endDate          DateTime?
  locations          String[]
  selectedScreenIds  String[]      @default([])
  requestedAutos     Int            @default(0)
  allocatedAutos     Int            @default(0)
  budgetInr          Int            @default(0)
  estimatedReach     Int            @default(0)
  scheduledPlays     Int?
  creativeId         String?
  operatingStart     String         @default("08:00")
  operatingEnd       String         @default("20:00")
  daysOfWeek         String[]       @default([])
  frequencyCap       Int            @default(8)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  company  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creative Creative?            @relation(fields: [creativeId], references: [id])
  events   CampaignStatusEvent[]
  invoices Invoice[]
  payments Payment[]
  reports  PlaybackReport[]

  @@index([companyId])
  @@index([status])
}

model CampaignStatusEvent {
  id             String          @id @default(cuid())
  campaignId     String
  /** Status before this transition; null for the first recorded event. */
  previousStatus CampaignStatus?
  status         CampaignStatus
  note           String          @default("")
  /** Display label for the actor (advertiser email, admin, or system). */
  actorLabel     String          @default("")
  actorUserId    String?
  createdAt      DateTime        @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  publicId      String        @unique
  companyId     String
  campaignId    String?
  campaignName  String
  amountInr     Int
  paymentStatus PaymentStatus @default(Pending)
  issuedOn      DateTime      @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId])
}

model Payment {
  id           String        @id @default(cuid())
  publicId     String        @unique
  companyId    String
  campaignId   String?
  campaignName String
  reference    String
  amountInr    Int
  status       PaymentStatus
  paidOn       DateTime      @default(now())

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])

  @@index([companyId])
}

model Notification {
  id         String   @id @default(cuid())
  companyId  String
  title      String
  body       String
  category   String   @default("Account")
  campaignId String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ActivityEvent {
  id        String       @id @default(cuid())
  companyId String
  title     String
  body      String
  kind      ActivityKind
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

/// Daily Proof of Play aggregates (ClickHouse → NestJS sync later)
model PlaybackDaily {
  id             String   @id @default(cuid())
  companyId      String
  date           DateTime @db.Date
  playbackStarts Int      @default(0)
  completedPlays Int      @default(0)
  failedPlays    Int      @default(0)
  scheduledPlays Int      @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@index([companyId])
}

model PlaybackReport {
  id                String   @id @default(cuid())
  companyId         String
  campaignId        String
  periodLabel       String
  targetedDevices   Int      @default(0)
  activeDevices     Int      @default(0)
  playbackStarts    Int      @default(0)
  completedPlays    Int      @default(0)
  interruptedPlays  Int      @default(0)
  completionRate    Float    @default(0)
  runningHours      Int      @default(0)
  expenditureInr    Int      @default(0)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([campaignId])
}

model LocationPlayback {
  id              String @id @default(cuid())
  companyId       String
  area            String
  completedPlays  Int    @default(0)
  targetedDevices Int    @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, area])
  @@index([companyId])
}
