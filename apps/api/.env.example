PORT=3000
DATABASE_URL=postgresql://autoads:autoads@localhost:5435/autoads?schema=public

# Supabase Auth JWT verification (production)
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Local/dev only — allows Bearer test tokens without Supabase
AUTH_DEV_MODE=true
AUTH_DEV_SECRET=autoads-dev-secret

# Redis + BullMQ
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true
BULLMQ_ENABLED=true

# MQTT (EMQX local / AWS IoT Core in prod)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_ENABLED=true

# ClickHouse analytics
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_ENABLED=true

# S3 / MinIO + CloudFront
S3_ENDPOINT=http://127.0.0.1:9002
S3_BUCKET=autoads-creatives
S3_ACCESS_KEY=autoads
S3_SECRET_KEY=autoadssecret
AWS_REGION=ap-south-1
MEDIA_CDN_URL=http://127.0.0.1:9002/autoads-creatives

# AWS SQS (optional locally)
AWS_SQS_QUEUE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Monitoring
SENTRY_DSN=

# Optional seed scenario: empty | drafts | pending | live | completed
SEED_SCENARIO=empty
