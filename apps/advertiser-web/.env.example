# NestJS REST API (advertiser-scoped endpoints + RBAC)
# Leave empty for offline empty-workspace mode
VITE_API_BASE_URL=http://localhost:3000

# Supabase Auth (JWT validated by NestJS; Postgres RLS enforces company scope)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Creative media via S3 + CloudFront
VITE_MEDIA_CDN_URL=https://cdn.example.com
